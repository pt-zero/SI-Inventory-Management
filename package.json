{
  "name": "Inventory-Management-System",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "dotnet run --project backend/Inventory.Api",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "dotnet build backend/Inventory.Api",
    "preview": "vite preview --host 0.0.0.0",
    "start": "dotnet run --project backend/Inventory.Api --configuration Release"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "firebase": "^13.0.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
