{
  "name": "Inventory-Management-System",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "dotnet run --project backend/Inventory.Api",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "dotnet build backend/Inventory.Api",
    "preview": "vite preview --host 0.0.0.0",
    "start": "dotnet run --project backend/Inventory.Api --configuration Release"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
